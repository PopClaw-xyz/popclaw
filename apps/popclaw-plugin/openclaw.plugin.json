  "skills": [
    "skills"
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "popclaw"
    ]
  },
  "commandAliases": [
    {
      "name": "popclaw",
      "kind": "runtime-slash"
    }
  ],
  "contracts": {
