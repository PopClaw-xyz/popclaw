exports[`dev CLI retains its separate synchronous profile polling protocol > approved 1`] = `
{
  "result": {
    "verified": true,
  },
  "trace": [
    [
      "initiate",
      {
        "handle": "@blackfeather",
        "mirrorOptin": true,
        "nickname": "Owner",
        "platform": "x",
        "proofUrl": undefined,
      },
    ],
    [
      "info",
      "invite submitted. event_id=event-1",
    ],
    [
      "info",
      "step 1 (yours): post "@blackfeather#abcdef" on x — a new post or a self-reply, never the bio. step 2: rangers verify within ~a minute. step 3: you get told either way. Valid 48h; the sigil never changes; expiring costs you nothing. If REJECTED (new/small accounts are often invisible to search), retry immediately with --proof=<post url> — only a still-pending task is throttled (24h)",
    ],
    [
      "info",
      "polling /v1/profile for verification (Ctrl-C to stop; check again later with \`popclaw status\`)",
    ],
    [
      "sleep",
      10,
    ],
    [
      "profile-fetch",
      "https://house.test/v1/profile/OWNER",
    ],
    [
      "info",
      "✓ invite APPROVED — you are now verified as x:@blackfeather",
    ],
  ],
}
`;

